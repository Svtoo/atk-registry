#!/bin/sh
# Refuse a staged leak, then keep index.yaml in step with the plugin tree.
set -e

if ! make --silent validate >/dev/null 2>&1; then
    make --silent validate 2>&1 | sed -n '/✗/,$p'
    exit 1
fi

if git diff --cached --name-only | grep -q '^plugins/'; then
    make --silent generate >/dev/null
    if ! git diff --quiet -- index.yaml; then
        git add index.yaml
        echo "pre-commit: index.yaml regenerated and staged"
    fi
fi
